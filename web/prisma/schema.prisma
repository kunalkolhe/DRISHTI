generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CITIZEN
  FIELD_WORKER
  DEPT_OFFICER
  CONTRACTOR
  ADMIN
}

enum ComplaintStatus {
  OPEN
  ROUTED
  FIXED_PENDING_CONFIRMATION
  CLOSED
  REJECTED
  REOPENED
}

model User {
  id               Int      @id @default(autoincrement())
  name             String
  email            String?  @unique
  mobileNumber     String   @unique
  passwordHash     String
  role             Role     @default(CITIZEN)
  department       String?
  photoUrl         String?
  trustScore       Float    @default(100.0)
  createdAt        DateTime @default(now())

  complaints       Complaint[] @relation("CitizenComplaints")
  assignedTasks    Complaint[] @relation("WorkerAssignments")
  serviceHistories ServiceHistory[] @relation("WorkerServices")
}

model Asset {
  id               Int           @id @default(autoincrement())
  qrCodeId         String        @unique
  category         String
  gpsLat           Float
  gpsLon           Float
  department       String
  area             String?
  installDate      DateTime?
  warrantyStatus   String?
  warrantyExpiry   DateTime?
  replacementCost  Float?
  riskScore        Float         @default(0.0)
  photoUrl         String?
  maintenanceIntervalDays Int?
  lastMaintenanceDate DateTime?
  createdAt        DateTime      @default(now())

  complaints       Complaint[]
  serviceHistories ServiceHistory[]
}

model Complaint {
  id               Int             @id @default(autoincrement())
  assetId          Int?
  citizenId        Int
  status           ComplaintStatus @default(OPEN)
  severity         String?
  description      String?
  address          String?
  gpsLat           Float?
  gpsLon           Float?
  originalPhotoUrl String
  voiceNoteUrl     String?
  repairPhotoUrl   String?
  workerNotes      String?
  resolvedAt       DateTime?
  resolvedByWorkerId Int?
  assignedToWorkerId Int?
  reopenReason     String?
  reopenCount      Int             @default(0)
  closedAt         DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  asset            Asset?          @relation(fields: [assetId], references: [id])
  citizen          User            @relation("CitizenComplaints", fields: [citizenId], references: [id])
  assignedWorker   User?           @relation("WorkerAssignments", fields: [assignedToWorkerId], references: [id])
}

model ServiceHistory {
  id               Int      @id @default(autoincrement())
  assetId          Int
  workerId         Int
  repairPhotoUrl   String
  repairCost       Float?
  type             String   @default("REPAIR") // "REPAIR" or "MAINTENANCE"
  notes            String?
  date             DateTime @default(now())

  asset            Asset    @relation(fields: [assetId], references: [id])
  worker           User     @relation("WorkerServices", fields: [workerId], references: [id])
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  entityType   String   // e.g., 'Complaint', 'Asset'
  entityId     Int
  action       String
  timestamp    DateTime @default(now())
  previousHash String?
  currentHash  String
}
