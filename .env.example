# Copy this file to .env and fill in real values. .env itself is gitignored
# and must never be committed.

DATABASE_URL="postgresql://drishti_user:drishti_password@localhost:5433/drishti_db?schema=public"

# Signs the login session cookie (HMAC-SHA256). Required in every
# environment — without it, every login fails. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value logs every signed-in user out.
SESSION_SECRET=""

# Authorizes GET /api/cron/escalate (Authorization: Bearer <this>). Required
# for that route to run at all — it refuses requests otherwise. Vercel Cron
# sends this header automatically once the env var exists on the project;
# any other scheduler (cron-job.org, a scheduled GitHub Action, etc.) needs
# it set as a custom header by hand. See vercel.json for the schedule.
CRON_SECRET=""

# Object storage for uploaded photos/voice notes (src/lib/storage.ts).
# docker-compose runs MinIO on these ports for local dev. Leave any of
# these three blank to fall back to local disk (/public/uploads) instead —
# fine for a quick local run, but files won't survive a redeploy.
# In production, point these at a real S3-compatible bucket (AWS S3,
# Cloudflare R2, DigitalOcean Spaces, or a hosted MinIO) instead.
MINIO_URL="http://localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="drishti-uploads"
# Only needed if the app reaches MinIO through a different address than
# browsers do (e.g. an internal Docker hostname vs. a public domain).
# MINIO_PUBLIC_URL=""

# --- Formal-complaint email (src/app/actions/sendComplaintEmail.ts) ---
# Leave SMTP_* unset to run in DUMMY mode: mail is accepted by a throwaway
# Ethereal inbox and never actually delivered, but you get a preview link.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""

# Overrides the placeholder government email domain / state name / city name
# baked into src/lib/departments.ts + src/lib/jurisdictions.ts. Replace the
# whole table with a real ward directory before going live.
# NEXT_PUBLIC_GOV_EMAIL_DOMAIN="city.gov.example"
# NEXT_PUBLIC_STATE_NAME="Maharashtra"
# NEXT_PUBLIC_CITY_NAME="Municipal Corporation"
