generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CITIZEN
  FIELD_WORKER
  DEPT_OFFICER
  CONTRACTOR
  ADMIN
}

enum ComplaintStatus {
  OPEN
  ROUTED
  FIXED_PENDING_CONFIRMATION
  CLOSED
  REJECTED
  REOPENED
}

enum NotificationType {
  NEW_COMPLAINT_IN_AREA
  COMPLAINT_RESOLVED
  COMPLAINT_CONFIRMED
  COMPLAINT_REOPENED
  COMPLAINT_LINKED_DUPLICATE
  SLA_ESCALATED
}

model User {
  id               Int      @id @default(autoincrement())
  name             String
  email            String?  @unique
  mobileNumber     String   @unique
  passwordHash     String
  role             Role     @default(CITIZEN)
  department       String?
  photoUrl         String?
  // Field worker's allocated area — mirrors the "worker_area" cookie so
  // notifications can be targeted server-side without reading a cookie
  // that belongs to a different request/user.
  area             String?
  trustScore       Float    @default(100.0)
  createdAt        DateTime @default(now())

  complaints       Complaint[] @relation("CitizenComplaints")
  assignedTasks    Complaint[] @relation("WorkerAssignments")
  serviceHistories ServiceHistory[] @relation("WorkerServices")
  notifications    Notification[]
}

model Asset {
  id               Int           @id @default(autoincrement())
  qrCodeId         String        @unique
  category         String
  gpsLat           Float
  gpsLon           Float
  department       String
  area             String?
  installDate      DateTime?
  warrantyStatus   String?
  warrantyExpiry   DateTime?
  replacementCost  Float?
  riskScore        Float         @default(0.0)
  photoUrl         String?
  maintenanceIntervalDays Int?
  lastMaintenanceDate DateTime?
  createdAt        DateTime      @default(now())

  complaints       Complaint[]
  serviceHistories ServiceHistory[]
}

model Complaint {
  id               Int             @id @default(autoincrement())
  assetId          Int?
  citizenId        Int
  status           ComplaintStatus @default(OPEN)
  severity         String?
  description      String?
  address          String?
  gpsLat           Float?
  gpsLon           Float?
  originalPhotoUrl String
  voiceNoteUrl     String?
  repairPhotoUrl   String?
  workerNotes      String?
  // Advisory notes from an automated EXIF check (GPS + capture time) on
  // each proof photo — never blocks anything, just surfaced to whoever
  // decides whether to trust the photo. Empty array = nothing flagged.
  reportPhotoFlags String[]        @default([])
  repairPhotoFlags String[]        @default([])
  // Set when this complaint was auto-detected as reporting the same
  // real-world problem as an earlier still-open one — see lib/duplicates.ts.
  // The duplicate still belongs to its own citizen and gets its own
  // confirm/reject, it just doesn't trigger a second round of worker alerts,
  // and is fixed in lockstep with the original.
  duplicateOfId    Int?
  // How many full SLA windows this complaint has been left open past —
  // 0 = on time, 1 = just breached, 2+ = breached again since. Sees
  // src/app/api/cron/escalate/route.ts; lets that job escalate a complaint
  // exactly once per tier instead of re-notifying everyone every run.
  slaEscalationTier Int            @default(0)
  lastEscalatedAt  DateTime?
  resolvedAt       DateTime?
  resolvedByWorkerId Int?
  assignedToWorkerId Int?
  reopenReason     String?
  reopenCount      Int             @default(0)
  closedAt         DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  asset            Asset?          @relation(fields: [assetId], references: [id])
  citizen          User            @relation("CitizenComplaints", fields: [citizenId], references: [id])
  assignedWorker   User?           @relation("WorkerAssignments", fields: [assignedToWorkerId], references: [id])
  duplicateOf      Complaint?      @relation("ComplaintDuplicates", fields: [duplicateOfId], references: [id])
  duplicates       Complaint[]     @relation("ComplaintDuplicates")
}

model ServiceHistory {
  id               Int      @id @default(autoincrement())
  assetId          Int
  workerId         Int
  repairPhotoUrl   String
  repairCost       Float?
  type             String   @default("REPAIR") // "REPAIR" or "MAINTENANCE"
  notes            String?
  date             DateTime @default(now())

  asset            Asset    @relation(fields: [assetId], references: [id])
  worker           User     @relation("WorkerServices", fields: [workerId], references: [id])
}

model Notification {
  id          Int              @id @default(autoincrement())
  userId      Int
  type        NotificationType
  title       String
  message     String
  link        String?
  complaintId Int?
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id])

  @@index([userId, read])
  @@index([userId, createdAt])
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  entityType   String   // e.g., 'Complaint', 'Asset'
  entityId     Int
  action       String
  timestamp    DateTime @default(now())
  previousHash String?
  currentHash  String
}
